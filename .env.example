# Copy to .env for local Compose. Compose does not substitute these values.
# Production must set its own database, Firebase, and storage secrets.
# Local development only. Do not use these passwords outside this machine.
POSTGRES_USER=monytix
POSTGRES_PASSWORD=monytix
POSTGRES_DB=monytix
POSTGRES_PORT=5432
API_DB_PASSWORD=monytix_api_local
INTELLIGENCE_DB_PASSWORD=monytix_intelligence_local
DATABASE_URL=postgres://monytix_api:monytix_api_local@postgres:5432/monytix
INTELLIGENCE_DATABASE_URL=postgres://monytix_intelligence:monytix_intelligence_local@postgres:5432/monytix
API_PORT=3000
INTELLIGENCE_URL=http://intelligence:8000
FIREBASE_PROJECT_ID=local-firebase-project
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json
LOG_LEVEL=info
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=statements
OBJECT_STORAGE_ACCESS_KEY_ID=local-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=local-secret-key
UPLOAD_MAX_BYTES=10485760
UPLOAD_GRANT_TTL_SECONDS=900
MALWARE_SCANNER=clamav
MALWARE_SCAN_REQUIRED=true
STATEMENT_RETENTION_DAYS=90
UNCOMPLETED_UPLOAD_RETENTION_HOURS=24
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Gmail connect returns unavailable until all five are set on the API.
# Dokploy must set the same five on the api service before the app can open Google.
# GMAIL_TOKEN_ENCRYPTION_KEY is 32 random bytes, base64-encoded.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_TOKEN_URI=https://oauth2.googleapis.com/token
GMAIL_TOKEN_ENCRYPTION_KEY=
# Pub/Sub topic Gmail pushes to after connect, for example projects/your-proj/topics/gmail-txns.
GMAIL_PUBSUB_TOPIC=
# When true, gmail-worker logs parsed alert fields and does not write them.
GMAIL_DEBUG_DRY_RUN=false
