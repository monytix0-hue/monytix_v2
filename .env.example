# Copy to .env for local Compose. Compose does not substitute these values.
# Production must set its own database, Firebase, and storage secrets.
# One Supabase project. Port 5432 and sslmode=require.
# Do not use the transaction pooler on port 6543.
# If db.<project-ref>.supabase.co has no IPv4 route, use the session pooler.
# Pooler usernames are <role>.<project-ref>.
POSTGRES_HOST=aws-0-region.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.projectref
POSTGRES_PASSWORD=
API_DB_PASSWORD=
INTELLIGENCE_DB_PASSWORD=
# uselibpqcompat keeps node-pg from treating sslmode=require as full certificate verification.
DATABASE_URL=postgresql://monytix_api.projectref:@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true
INTELLIGENCE_DATABASE_URL=postgresql://monytix_intelligence.projectref:@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
API_PORT=3000
INTELLIGENCE_URL=http://intelligence:8000
FIREBASE_PROJECT_ID=local-firebase-project
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json
LOG_LEVEL=info
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=statements
OBJECT_STORAGE_ACCESS_KEY_ID=local-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=local-secret-key
UPLOAD_MAX_BYTES=10485760
UPLOAD_GRANT_TTL_SECONDS=900
MALWARE_SCANNER=clamav
MALWARE_SCAN_REQUIRED=true
STATEMENT_RETENTION_DAYS=90
UNCOMPLETED_UPLOAD_RETENTION_HOURS=24
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Gmail connect returns unavailable until all five are set on the API.
# Dokploy must set the same five on the api service before the app can open Google.
# GMAIL_TOKEN_ENCRYPTION_KEY is 32 random bytes, base64-encoded.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_TOKEN_URI=https://oauth2.googleapis.com/token
GMAIL_TOKEN_ENCRYPTION_KEY=
# Pub/Sub topic Gmail pushes to after connect, for example projects/your-proj/topics/gmail-txns.
GMAIL_PUBSUB_TOPIC=
# When true, gmail-worker logs parsed alert fields and does not write them.
GMAIL_DEBUG_DRY_RUN=false
