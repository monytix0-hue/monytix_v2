{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monytix.dev/events/statement.parsed.schema.json",
  "title": "statement.parsed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "type": {
      "const": "statement.parsed"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statementId"
      ],
      "properties": {
        "statementId": {
          "type": "string"
        }
      }
    }
  }
}
